    "@agentboard/memory": "workspace:*",
    "@agentboard/orchestrator": "workspace:*",
    "@agentboard/queue": "workspace:*",
    "@agentboard/shared": "workspace:*",
    "fastify": "^4.26.0",
    "telegraf": "^4.16.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
