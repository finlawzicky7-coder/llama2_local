{
  "name": "04 - Lead Scoring",
  "nodes": [
    {
      "parameters": {"httpMethod":"POST","path":"medicare-score-lead","responseMode":"responseNode"},
      "id":"wh","name":"Score Webhook","type":"n8n-nodes-base.webhook","typeVersion":1,
      "position":[200,320],"webhookId":"medicare-score-lead"
    },
    {
      "parameters": {
        "url": "={{$env.SUPABASE_URL}}/rest/v1/rpc/fn_score_lead",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {"parameters": [
          {"name":"apikey","value":"={{$env.SUPABASE_SERVICE_ROLE_KEY}}"},
          {"name":"Authorization","value":"=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}"},
          {"name":"Content-Type","value":"application/json"}
        ]},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"p_lead_id\":\"{{$json.body.lead_id}}\",\"p_intent\":{{$json.body.intent_score || null}}}"
      },
      "id":"score","name":"Run Score Function","type":"n8n-nodes-base.httpRequest","typeVersion":4,
      "position":[440,320]
    },
    {
      "parameters": {
        "functionCode": "const score = parseInt(items[0].json, 10) || 0;\nlet bucket = 'nurture';\nif (score >= 80) bucket = 'hot';\nelse if (score >= 50) bucket = 'warm';\nreturn [{json:{lead_id: $('Score Webhook').item.json.body.lead_id, score, bucket}}];"
      },
      "id":"bucketize","name":"Bucketize","type":"n8n-nodes-base.function","typeVersion":1,
      "position":[660,320]
    },
    {
      "parameters": {
        "url": "={{$env.SUPABASE_URL}}/rest/v1/leads?id=eq.{{$json.lead_id}}",
        "method": "PATCH",
        "sendHeaders": true,
        "headerParameters": {"parameters":[
          {"name":"apikey","value":"={{$env.SUPABASE_SERVICE_ROLE_KEY}}"},
          {"name":"Authorization","value":"=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}"},
          {"name":"Content-Type","value":"application/json"}
        ]},
        "sendBody": true,"specifyBody":"json",
        "jsonBody": "={\"lead_score\":{{$json.score}},\"bucket\":\"{{$json.bucket}}\"}"
      },
      "id":"update","name":"Update Lead Score","type":"n8n-nodes-base.httpRequest","typeVersion":4,
      "position":[880,320]
    },
    {
      "parameters": {
        "url": "={{$env.N8N_BASE_URL}}/webhook/medicare-route-lead",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {"parameters":[
          {"name":"Content-Type","value":"application/json"},
          {"name":"x-internal-token","value":"={{$env.N8N_INTERNAL_TOKEN}}"}
        ]},
        "sendBody": true,"specifyBody":"json",
        "jsonBody": "={\"lead_id\":\"{{$('Bucketize').item.json.lead_id}}\",\"bucket\":\"{{$('Bucketize').item.json.bucket}}\"}"
      },
      "id":"trigger","name":"Trigger Routing","type":"n8n-nodes-base.httpRequest","typeVersion":4,
      "position":[1100,320]
    },
    {
      "parameters":{"respondWith":"json","responseBody":"={\"status\":\"scored\",\"score\":{{$('Bucketize').item.json.score}},\"bucket\":\"{{$('Bucketize').item.json.bucket}}\"}"},
      "id":"ok","name":"OK","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[1320,320]
    }
  ],
  "connections": {
    "Score Webhook":{"main":[[{"node":"Run Score Function","type":"main","index":0}]]},
    "Run Score Function":{"main":[[{"node":"Bucketize","type":"main","index":0}]]},
    "Bucketize":{"main":[[{"node":"Update Lead Score","type":"main","index":0}]]},
    "Update Lead Score":{"main":[[{"node":"Trigger Routing","type":"main","index":0}]]},
    "Trigger Routing":{"main":[[{"node":"OK","type":"main","index":0}]]}
  },
  "settings":{"executionOrder":"v1"},
  "tags":["medicare","scoring"]
}
