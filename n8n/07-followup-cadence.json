          {"name":"Authorization","value":"=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}"}
        ]}
      },
      "id":"fetch","name":"Fetch + Reachability","type":"n8n-nodes-base.httpRequest","typeVersion":4,
      "position":[420,320]
    },
    {
      "parameters":{"conditions":{"boolean":[{"value1":"={{$json[0].is_reachable}}","value2":true}]}},
      "id":"if","name":"If Reachable","type":"n8n-nodes-base.if","typeVersion":1,
      "position":[640,320]
    },
    {
      "parameters":{"functionCode":"// Build a 14-day cadence based on bucket. Each step has channel + delay_minutes + template.\nconst lead = items[0].json[0];\nconst bucket = lead.bucket;\nconst FIRST_NAME = lead.first_name || 'there';\nconst AGENT_FIRST = 'your licensed agent';\nconst BIZ = 'Acme Insurance';\nconst tpmoShort = `We do not offer every plan available in your area. Currently we represent multiple carriers and offer products in your area. Please contact Medicare.gov, 1-800-MEDICARE, or your local SHIP for all your options.`;\nconst hot = [\n  {channel:'sms',  delay:0,    body:`Hi ${FIRST_NAME}, this is ${BIZ}. We received your Medicare review request and tried to reach you. ${tpmoShort} Reply STOP to opt out. Reply HELP for help. Reply CALL to schedule.`},\n  {channel:'email',delay:5,    template:'speed_to_lead_email_v1'},\n  {channel:'voicemail', delay:30, template:'speed_to_lead_vm_v1'},\n  {channel:'sms',  delay:60*4,  body:`${FIRST_NAME}, still happy to help review your Medicare options. Reply CALL to schedule with a licensed agent. Reply STOP to opt out.`},\n  {channel:'email',delay:60*24, template:'day1_followup_v1'},\n  {channel:'sms',  delay:60*24*3,body:`${FIRST_NAME}, would tomorrow work for a quick 15-min review? Reply YES or pick a time. STOP to opt out.`},\n  {channel:'email',delay:60*24*7, template:'day7_education_v1'},\n  {channel:'email',delay:60*24*14,template:'day14_lastcall_v1'}\n];\nconst warm = hot.slice(1); // skip the immediate SMS\nconst nurture = [\n  {channel:'email', delay:60*24*1, template:'edu_day1'},\n  {channel:'email', delay:60*24*4, template:'edu_day4'},\n  {channel:'email', delay:60*24*7, template:'edu_day7'},\n  {channel:'email', delay:60*24*14,template:'edu_day14'},\n  {channel:'email', delay:60*24*30,template:'monthly_evergreen'}\n];\nconst plan = bucket==='hot'?hot:bucket==='warm'?warm:nurture;\nreturn plan.map(step => ({json:{...step, lead_id: lead.id, phone: lead.phone, email: lead.email, first_name: FIRST_NAME}}));"},
      "id":"plan","name":"Build Cadence","type":"n8n-nodes-base.function","typeVersion":1,
      "position":[860,200]
    },
    {
      "parameters":{
        "amount":"={{$json.delay}}",
        "unit":"minutes"
      },
      "id":"wait","name":"Wait","type":"n8n-nodes-base.wait","typeVersion":1,
