# ── LLM Provider ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Optional: swap to OpenAI or Groq
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
LLM_PROVIDER=anthropic          # anthropic | openai | groq
LLM_MODEL=claude-sonnet-4-20250514

# ── Web Search ────────────────────────────────────────────────
SERPER_API_KEY=               # serper.dev key for Google search

# ── Email (SendGrid) ─────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=broker@yourbrokerage.com
SENDGRID_FROM_NAME=Your Brokerage

# ── Voice (Twilio) ───────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite:///./crebrokerai.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/crebrokerai

# ── Dashboard ────────────────────────────────────────────────
STREAMLIT_PORT=8501
API_PORT=8000
