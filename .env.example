# Ringback — environment variables (Cycle 1 MVP scope)
# Copy to `.env` and fill in. Never commit `.env`.

# ── App
APP_ENV=development           # development | staging | production
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# ── Supabase / Postgres
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ── Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VOICE_WEBHOOK_PATH=/voice/incoming
TWILIO_SMS_WEBHOOK_PATH=/sms/incoming
TWILIO_MESSAGING_SERVICE_SID=

# ── LLM provider (provider-agnostic adapter; default is generic)
LLM_PROVIDER=generic          # generic | (configure your own)
LLM_MODEL=                    # e.g. a function-calling model id
LLM_API_KEY=
LLM_BASE_URL=                 # optional, for self-hosted

# ── ElevenLabs (optional TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TIER1=
STRIPE_PRICE_TIER2=
STRIPE_PRICE_TIER3=
STRIPE_METER_BOOKED_JOB=

# ── Google Calendar (per-tenant OAuth tokens are stored in Postgres,
#    not env. These are only the platform-level OAuth client.)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# ── Resend (email)
RESEND_API_KEY=
RESEND_FROM=ringback@yourdomain.example

# ── Zapier outbound webhook (per-tenant; this is just the default sample)
ZAPIER_BOOKING_WEBHOOK_URL=
